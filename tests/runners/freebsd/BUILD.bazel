"""FreeBSD test runner — syscall-translating loader.

Patches FreeBSD syscall numbers to Linux equivalents at load time,
then executes the blob under QEMU with real Linux syscalls.
"""

load("//bazel:cc_binary.bzl", "pic_cc_binary")
load("//bazel:lint.bzl", "cppcheck_test")

package(default_visibility = [
    "//python:__subpackages__",
    "//release:__pkg__",
    "//tests:__subpackages__",
])

pic_cc_binary(
    name = "runner",
    srcs = ["runner.c"],
    hdrs = glob(["start/*.h"]),
    linkopts = [
        "-static",
        "-Wl,-e,_start",
    ],
    quote_includes = ["tests/runners/freebsd"],
    deps = [
        "//src/include/picblobs:headers",
    ],
)

cppcheck_test(
    name = "runner_cppcheck",
    size = "small",
    srcs = ["runner.c"],
    include_dirs = ["src/include"],
)
