"""Linux test runners — one per target architecture.

Each runner is a freestanding static binary that loads and executes
a blob using real Linux syscalls (emulated by QEMU for non-native arches).
"""

load("//bazel:cc_binary.bzl", "pic_cc_binary")
load("//bazel:lint.bzl", "cppcheck_test")

package(default_visibility = [
    "//python:__subpackages__",
    "//release:__pkg__",
    "//tests:__subpackages__",
])

exports_files([
    "runner_hosted.c",
])

filegroup(
    name = "start_headers",
    srcs = glob(["start/*.h"]),
    visibility = ["//tests:__subpackages__"],
)

pic_cc_binary(
    name = "runner",
    srcs = ["runner.c"],
    hdrs = glob(["start/*.h"]),
    linkopts = [
        "-static",
        "-Wl,-e,_start",
    ],
    quote_includes = ["tests/runners/linux"],
    deps = [
        "//src/include/picblobs:headers",
    ],
)

cppcheck_test(
    name = "runner_cppcheck",
    size = "small",
    srcs = ["runner.c"],
    include_dirs = ["src/include"],
)

# Hosted-mode runner — passes pic_platform vtable to blobs instead of
# relying on raw syscalls. Used to test the PIC_PLATFORM_HOSTED code path
# without needing real Mbed OS hardware.
pic_cc_binary(
    name = "runner_hosted",
    srcs = ["runner_hosted.c"],
    hdrs = glob(["start/*.h"]),
    linkopts = [
        "-static",
        "-Wl,-e,_start",
    ],
    quote_includes = ["tests/runners/linux"],
    deps = [
        "//src/include/picblobs:headers",
    ],
)
