"""Windows test runners — mock TEB/PEB environment on Linux.

The runner is a freestanding static Linux binary that constructs
a synthetic Windows environment (TEB, PEB, module list, PE export
tables) and executes a Windows-targeting blob within it.
"""

load("//bazel:cc_binary.bzl", "pic_cc_binary")
load("//bazel:lint.bzl", "cppcheck_test")

package(default_visibility = [
    "//python:__subpackages__",
    "//release:__pkg__",
    "//tests:__subpackages__",
])

pic_cc_binary(
    name = "runner",
    srcs = ["runner.c"],
    hdrs = glob(["start/*.h"]),
    copts = select({
        "//platforms:is_cpu_aarch64": ["-ffixed-x18"],
        "//conditions:default": [],
    }),
    linkopts = [
        "-static",
    ],
    quote_includes = ["tests/runners/windows"],
    deps = [
        "//src/include/picblobs:headers",
    ],
)

cppcheck_test(
    name = "runner_cppcheck",
    size = "small",
    srcs = ["runner.c"],
    include_dirs = ["src/include"],
)
